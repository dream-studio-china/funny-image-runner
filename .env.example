# Aliyun RDS MySQL. Use a TLS-enabled connection URL in production.
DATABASE_URL=mysql://app_user:change-me@your-rds-host:3306/funny_image_runner
# Optional base64-encoded RDS CA PEM. Production connections require TLS certificate validation.
MYSQL_SSL_CA_BASE64=

# Generate with: openssl rand -base64 32
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
# Configure the same secret on the local worker process. Never expose it to browsers.
WORKER_TOKEN=replace-with-a-long-random-worker-token
WEB_API_BASE_URL=https://your-site.example
# Set on the ComfyUI host; keep ComfyUI bound to loopback.
COMFY_BASE_URL=http://127.0.0.1:8188
# The Worker uses Node 22.21+ proxy support and automatically bypasses COMFY_BASE_URL.
# Optional stable worker identity/display name; defaults to comfy-{hostname} and that ID.
WORKER_ID=
WORKER_NAME=
# Used to encrypt issued invite codes for idempotent order retries. Generate with: openssl rand -base64 32
INVITATION_ENCRYPTION_KEY=replace-with-32-random-bytes-base64
INVITATION_TTL_DAYS=30
APP_BASE_URL=http://localhost:3000
# Qiniu Kodo private bucket. Keep AccessKey/SecretKey server-side only.
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# Select the HTTPS upload endpoint matching this bucket's region.
QINIU_UPLOAD_URL=https://up.qiniup.com
QINIU_PRIVATE_DOMAIN=https://your-private-download-domain.example
SESSION_COOKIE_NAME=funny_image_runner_session
SESSION_TTL_DAYS=30
